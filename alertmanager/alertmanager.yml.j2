global:
  resolve_timeout: 5m
route:
  receiver: {% if obstack_alertmanager_webhook_url | default('') | length > 0 %}obstack-webhook{% else %}default-sink{% endif %}
  group_by: ["alertname", "project", "environment", "server", "application", "host"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: default-sink
{% if obstack_alertmanager_webhook_url | default('') | length > 0 %}
  - name: obstack-webhook
    webhook_configs:
      - url: {{ obstack_alertmanager_webhook_url | tojson }}
        send_resolved: true
{% endif %}
inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["alertname", "project", "environment", "server", "application", "host"]
