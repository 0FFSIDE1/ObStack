// ObStack managed Alloy configuration. Secrets are read from container environment.
logging {
  level = "info"
  format = "logfmt"
}
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path = "/host/sys"
  rootfs_path = "/host/root"
}
prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.obstack.receiver]
}
prometheus.remote_write "obstack" {
  endpoint {
    url = "{{ obstack_alloy_remote_write_url }}"
    basic_auth {
      username = sys.env("OBSTACK_METRICS_USERNAME")
      password = sys.env("OBSTACK_METRICS_PASSWORD")
    }
    tls_config {
      ca_file = "{{ obstack_alloy_ca_file }}"
      insecure_skip_verify = false
    }
  }
  external_labels = {
    platform = "obstack",
    host = "{{ inventory_hostname }}",
    project = "{{ project | default('unassigned') }}",
    environment = "{{ environment | default('unknown') }}",
  }
}
loki.write "obstack" {
  endpoint {
    url = "{{ obstack_alloy_loki_url }}"
    tenant_id = "{{ obstack_alloy_tenant_id }}"
    basic_auth {
      username = sys.env("OBSTACK_LOGS_USERNAME")
      password = sys.env("OBSTACK_LOGS_PASSWORD")
    }
    tls_config {
      ca_file = "{{ obstack_alloy_ca_file }}"
      insecure_skip_verify = false
    }
  }
}
