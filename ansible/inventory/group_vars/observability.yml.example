---
# Copy to group_vars/observability.yml and replace every placeholder.
# Encrypt this file with ansible-vault before adding any credentials.
obstack_repo_root: REPLACE_WITH_ABSOLUTE_PATH_TO_CHECKED_OUT_OBSTACK_REPO
obstack_ssh_allowed_cidr: REPLACE_WITH_ADMIN_PUBLIC_IPV4_CIDR
obstack_wg_vpn_ip: REPLACE_WITH_APPROVED_CENTRAL_WIREGUARD_IPV4
obstack_grafana_admin_user: admin
# Define obstack_grafana_admin_password in an encrypted Vault vars file.
